diff --git a/src/bootp.c b/src/bootp.c
index 23e07b67..7e55b4d9 100644
--- a/src/bootp.c
+++ b/src/bootp.c
@@ -398,7 +398,18 @@ static void bootp_reply(Slirp *slirp,
     assert(q < end);
     *q++ = RFC1533_END;
 
-    daddr.sin_addr.s_addr = 0xffffffffu;
+    /*
+     * RFC 1542: unicast the reply to the client when we know its address --
+     * daddr.sin_addr already carries it (the request's ciaddr, or the yiaddr we
+     * just assigned); it is left 0xffffffff only for the DHCPNAK case above.
+     * Broadcast only if no address is known at all.  The previous unconditional
+     * broadcast here silently dropped the reply for any client that already had
+     * an address and was not in promiscuous mode -- notably the Indy PROM, which
+     * only enables promiscuous receive while ciaddr == 0 ("No server for ...").
+     */
+    if (daddr.sin_addr.s_addr == 0) {
+        daddr.sin_addr.s_addr = 0xffffffffu;
+    }
 
     assert(q <= end);
 
